            key={amenity.title.join(' ')}
            className={`hero-amenity-card hero-amenity-card--${amenity.variant}`}
            style={{ '--amenity-accent': amenity.accent } as CSSProperties}
            {...getRevealMotionProps(reducedMotion, {
              y: 26,
              duration: 0.78,
              delay: 0.08 + index * 0.06,
              amount: 0.1,
            })}
          >
            <span className="hero-amenity-card__number">{String(index + 1).padStart(2, '0')}</span>
            <span className="hero-amenity-card__eyebrow">{amenity.eyebrow}</span>
            <h3>
              <span>{amenity.title[0]}</span>
              <span>{amenity.title[1]}</span>
            </h3>
            <p>{amenity.body}</p>
          </motion.article>
        ))}
      </div>
    </section>
  )
}

function HeroReviewSwitch({
  variant,
  onChange,
}: {
  variant: HeroVariant
  onChange: (variant: HeroVariant) => void
}) {
  return (
    <div className="hero-review-switch" role="group" aria-label="Hero version review switch">
      <button
        type="button"
        className={variant === 'editorial' ? 'is-active' : ''}
        onClick={() => onChange('editorial')}
      >
        Editorial
      </button>
      <button
        type="button"
        className={variant === 'classic' ? 'is-active' : ''}
        onClick={() => onChange('classic')}
      >
        Classic
      </button>
    </div>
  )
}

function BookingConcierge({ variant = 'section' }: { variant?: 'section' | 'hero' }) {
  const conciergeRef = useRef<HTMLDivElement>(null)
  const [openPanel, setOpenPanel] = useState<BookingPanel | null>(null)
  const [selectedLocation, setSelectedLocation] = useState<string | null>(null)
  const [selectedPlan, setSelectedPlan] = useState<(typeof workspaceTypes)[number] | null>(null)
  const [seats, setSeats] = useState<number | null>(null)
  const [isEnquiryOpen, setIsEnquiryOpen] = useState(false)
  const [isEnquirySent, setIsEnquirySent] = useState(false)
  const [hasTriedBooking, setHasTriedBooking] = useState(false)
  const [enquiryForm, setEnquiryForm] = useState({
    name: '',
    email: '',
    phone: '',
    company: '',
    notes: '',
  })

  useEffect(() => {
    if (!openPanel) return

    const handlePointerDown = (event: MouseEvent | TouchEvent) => {
      if (!conciergeRef.current?.contains(event.target as Node)) {
        setOpenPanel(null)
      }
    }

    document.addEventListener('mousedown', handlePointerDown)
    document.addEventListener('touchstart', handlePointerDown)

    return () => {
      document.removeEventListener('mousedown', handlePointerDown)
      document.removeEventListener('touchstart', handlePointerDown)
    }
  }, [openPanel])

  useEffect(() => {
    if (!isEnquiryOpen) return

    const previousOverflow = document.body.style.overflow
    const handleEscape = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        setIsEnquiryOpen(false)
      }
    }

    document.body.style.overflow = 'hidden'
    window.addEventListener('keydown', handleEscape)

    return () => {
      document.body.style.overflow = previousOverflow
      window.removeEventListener('keydown', handleEscape)
    }
  }, [isEnquiryOpen])

  const togglePanel = (panel: BookingPanel) => {
    setOpenPanel((currentPanel) => (currentPanel === panel ? null : panel))
  }

  const handleEnquirySubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()
    setIsEnquirySent(true)
  }

  const closeEnquiryModal = () => {
    setIsEnquiryOpen(false)
    window.setTimeout(() => {
      setIsEnquirySent(false)
    }, 240)
  }

  const selectedSummary = [
    selectedLocation ? { label: 'Location', value: selectedLocation } : null,
    seats ? { label: 'Seats', value: `${seats}` } : null,
    selectedPlan ? { label: 'Workspace', value: selectedPlan.name } : null,
  ].filter(Boolean) as Array<{ label: string; value: string }>

  const isEnquiryReady = Boolean(selectedLocation && seats && selectedPlan)
  const nextRequiredPanel: BookingPanel | null = !selectedLocation
    ? 'location'
    : !seats
      ? 'seats'
      : !selectedPlan
        ? 'plan'
        : null
  const requiredHint =
    nextRequiredPanel === 'location'
      ? 'Choose a branch first, then we can book the tour.'
      : nextRequiredPanel === 'seats'
        ? 'Add your team size so we know what kind of room to prepare.'
        : nextRequiredPanel === 'plan'
          ? 'Pick a workspace type to complete the tour request.'
          : ''

  return (
    <>
    <div
      ref={conciergeRef}
      className={variant === 'hero' ? 'booking-console booking-console--hero' : 'booking-console'}
      aria-label="Book a Work Hall workspace"
    >
      <div className="booking-fields">
        <div className="booking-popover booking-popover--location">
          <button
            type="button"
            className="booking-field"
            aria-expanded={openPanel === 'location'}
            onClick={() => togglePanel('location')}
          >
            <span>
              <strong>Choose a Location</strong>
              <small>{selectedLocation ?? 'Select a branch'}</small>
            </span>
            <SearchIcon />
          </button>

          {openPanel === 'location' && (
            <div className="booking-popover__panel booking-popover__panel--location">
              <div className="booking-popover__eyebrow">Choose the branch you want to visit</div>
              <div className="panel-grid panel-grid--stacked">
                {locations.map((location) => (
                  <button
                    type="button"
                    key={location}
                    className={location === selectedLocation ? 'panel-option is-selected' : 'panel-option'}
                    onClick={() => {
                      setSelectedLocation(location)
                      setOpenPanel(null)
                    }}
                  >
                    <span>{location}</span>
                    {location === selectedLocation && <CheckIcon />}
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>

        <div className="booking-popover booking-popover--seats">
          <button
            type="button"
            className="booking-field booking-field--seats"
            aria-expanded={openPanel === 'seats'}
            onClick={() => togglePanel('seats')}
          >
            <span>
              <strong>Seats Needed</strong>
              <small>{seats ? (seats === 1 ? 'Solo workspace' : `${seats} people`) : 'Choose team size'}</small>
            </span>
            <span className="seat-stepper" aria-hidden="true">
              {seats ?? '?'}
            </span>
          </button>

          {openPanel === 'seats' && (
            <div className="booking-popover__panel booking-popover__panel--seats">
              <div className="booking-popover__eyebrow">Set how many seats you need</div>
              <div className="seat-control seat-control--popover">
                <button
                  type="button"
                  aria-label="Decrease seats"
                  onClick={() => setSeats((currentSeats) => Math.max(1, (currentSeats ?? 1) - 1))}
                >
                  -
                </button>
                <strong>{seats ?? 1}</strong>
                <button
                  type="button"
                  aria-label="Increase seats"
                  onClick={() => setSeats((currentSeats) => Math.min(80, (currentSeats ?? 1) + 1))}
                >
                  +
                </button>
                <span>{(seats ?? 1) < 8 ? 'Ideal for founders and smaller teams.' : 'Useful if you already know your team size.'}</span>
              </div>
              <div className="booking-seat-presets">
                {[1, 3, 6, 12].map((preset) => (
                  <button
                    type="button"
                    key={preset}
                    className={seats === preset ? 'is-selected' : ''}
                    onClick={() => {
                      setSeats(preset)
                      setOpenPanel(null)
                    }}
                  >
                    {preset === 1 ? 'Solo' : `${preset} seats`}
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>

        <div className="booking-popover booking-popover--plan">
          <button
            type="button"
            className="booking-field booking-field--plan"
            aria-expanded={openPanel === 'plan'}
            onClick={() => togglePanel('plan')}
          >
            <span>
              <strong>Workspace Type</strong>
              <small>{selectedPlan?.name ?? 'Select a workspace'}</small>
            </span>
            <ChevronIcon open={openPanel === 'plan'} />
          </button>

          {openPanel === 'plan' && (
            <div className="booking-popover__panel booking-popover__panel--plan">
              <div className="booking-popover__eyebrow">Pick the setup that fits your enquiry</div>
              <div className="plan-list plan-list--popover">
                {workspaceTypes.map((plan) => (
                  <button
                    type="button"
                    key={plan.name}
                    className={plan.name === selectedPlan?.name ? 'plan-card is-selected' : 'plan-card'}
                    onClick={() => {
                      setSelectedPlan(plan)
                      setOpenPanel(null)
                    }}
                  >
                    <span className="plan-card__top">
                      <strong>{plan.name}</strong>
                      <em>{plan.price}</em>
                    </span>
                    <span className="plan-card__details">
                      {plan.details.map((detail) => (
                        <span key={detail}>
                          <CheckIcon />
                          {detail}
                        </span>
                      ))}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <div className="booking-action-row">
        <button
          type="button"
          className="primary-cta"
          aria-disabled={!isEnquiryReady}
          onClick={() => {
            if (!isEnquiryReady) {
              setHasTriedBooking(true)
              setOpenPanel(nextRequiredPanel)
              return
            }
            setOpenPanel(null)
            setIsEnquiryOpen(true)
          }}
        >
          Book My Tour
          <ArrowIcon />
        </button>
        <a href="#locations" className="ghost-cta">
          Explore Locations
        </a>
      </div>
      {hasTriedBooking && !isEnquiryReady && (
        <p className="booking-required-hint" role="status">
          {requiredHint}
        </p>
      )}
    </div>
    {isEnquiryOpen && typeof document !== 'undefined'
      ? createPortal(
        <div
          className="enquiry-modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="enquiry-title"
        >
          <button
            type="button"
            className="enquiry-modal__backdrop"
            aria-label="Close enquiry form"
            onClick={closeEnquiryModal}
          />
          <article className="enquiry-modal__card">
            <button
              type="button"
              className="enquiry-modal__close"
              aria-label="Close enquiry form"
              onClick={closeEnquiryModal}
            >
              ×
            </button>

            {!isEnquirySent ? (
              <>
                <div className="section-kicker">Book my tour</div>
                <h3 id="enquiry-title">Tell us what kind of workspace you want to tour.</h3>
                <p>
                  Complete the enquiry with your details and we will match you to the
                  right branch, seat count, and workspace setup.
                </p>

                {selectedSummary.length > 0 && (
                  <div className="enquiry-modal__summary">
                    {selectedSummary.map((item) => (
                      <span key={item.label}>
                        <small>{item.label}</small>
                        <strong>{item.value}</strong>
                      </span>
                    ))}
                  </div>
                )}

                <form className="enquiry-form" onSubmit={handleEnquirySubmit}>
                  <label>
                    <span>Full name</span>
                    <input
                      required
                      type="text"
                      value={enquiryForm.name}
                      onChange={(event) =>
                        setEnquiryForm((currentForm) => ({ ...currentForm, name: event.target.value }))
                      }
                    />
                  </label>
                  <label>
                    <span>Email address</span>
                    <input
                      required
                      type="email"
                      value={enquiryForm.email}
                      onChange={(event) =>
                        setEnquiryForm((currentForm) => ({ ...currentForm, email: event.target.value }))
                      }
                    />
                  </label>
                  <label>
                    <span>Phone number</span>
                    <input
                      type="tel"
                      placeholder="Optional"
                      value={enquiryForm.phone}
                      onChange={(event) =>
                        setEnquiryForm((currentForm) => ({ ...currentForm, phone: event.target.value }))
                      }
                    />
                  </label>
                  <label>
                    <span>Company or team name</span>
                    <input
                      type="text"
                      placeholder="Optional"
                      value={enquiryForm.company}
                      onChange={(event) =>
                        setEnquiryForm((currentForm) => ({ ...currentForm, company: event.target.value }))
                      }
                    />
                  </label>
                  <label className="enquiry-form__full">
                    <span>Anything we should know?</span>
                    <textarea
                      rows={4}
                      placeholder="Team size, preferred area, move-in timeline, private office vs desk, or any meeting room needs."
                      value={enquiryForm.notes}
                      onChange={(event) =>
                        setEnquiryForm((currentForm) => ({ ...currentForm, notes: event.target.value }))
                      }
                    />
                  </label>

                  <div className="enquiry-form__actions">
                    <button type="submit" className="primary-cta">
                      Send enquiry
                      <ArrowIcon />
                    </button>
                    <button type="button" className="ghost-cta" onClick={closeEnquiryModal}>
                      Not now
                    </button>
                  </div>
                </form>
              </>
            ) : (
              <div className="enquiry-success">
                <motion.div
                  className="enquiry-success__mark"
                  initial={{ scale: 0.72, opacity: 0 }}
                  animate={{ scale: 1, opacity: 1 }}
                  transition={{ type: 'spring', damping: 18, stiffness: 260 }}
                >
                  <motion.div
                    initial={{ scale: 0.6, opacity: 0 }}
                    animate={{ scale: 1, opacity: 1 }}
                    transition={{ duration: 0.45, ease: 'easeOut', delay: 0.15 }}
                  >
                    <CheckIcon />
                  </motion.div>
                </motion.div>
                <div className="section-kicker">Enquiry sent</div>
                <h3 id="enquiry-title">One of our representatives will contact you within 24 hours.</h3>
                <p>
                  We have your details. If you shared location, seats, or workspace type,
                  we will use that to narrow the first recommendation.
                </p>
                <button type="button" className="primary-cta" onClick={closeEnquiryModal}>
                  Close
                </button>
              </div>
            )}
          </article>
        </div>,
        document.body,
      )
      : null}
    </>
  )
}

function getInitialPricingAudience(): PricingPlan['audience'] {
  if (typeof window === 'undefined') return 'individuals'
  return window.location.hash === '#plans-teams' ? 'teams' : 'individuals'
}

function getDefaultPricingPlanId(audience: PricingPlan['audience']) {
  return pricingPlans.find((plan) => plan.audience === audience)?.id ?? pricingPlans[0].id
}

function PricingPlansCarousel({
  activeAudience,
  onAudienceChange,
}: {
  activeAudience: PricingPlan['audience']
  onAudienceChange: (audience: PricingPlan['audience']) => void
}) {
  const [activePlanId, setActivePlanId] = useState(() => getDefaultPricingPlanId(getInitialPricingAudience()))
  const [expandedPlan, setExpandedPlan] = useState<PricingPlan | null>(null)
  const reducedMotion = useReducedMotion()

  const planSignals: Record<string, Array<{ label: string; value: number }>> = {
    'air-plan': [
      { label: 'Flex', value: 92 },
      { label: 'Privacy', value: 34 },
      { label: 'Commitment', value: 28 },
    ],
    'x-plan': [
      { label: 'Routine', value: 78 },
      { label: 'Community', value: 82 },
      { label: 'Commitment', value: 46 },
    ],
    'virtual-office': [
      { label: 'Presence', value: 86 },
      { label: 'Remote fit', value: 88 },
      { label: 'Room use', value: 42 },
    ],
    'after-hours': [
      { label: 'Access', value: 94 },
      { label: 'Routine', value: 36 },
      { label: 'Night work', value: 84 },
    ],
    'box-plan': [
      { label: 'Privacy', value: 86 },
      { label: 'Focus', value: 78 },
      { label: 'Scale', value: 58 },
    ],
    'enterprise-plan': [
      { label: 'Control', value: 92 },
      { label: 'Scale', value: 88 },
      { label: 'Support', value: 76 },
    ],
    'custom-fit-outs': [
      { label: 'Tailoring', value: 96 },
      { label: 'Brand fit', value: 88 },
      { label: 'Scale', value: 82 },
    ],
  }

  const audiencePlans = pricingPlans.filter((plan) => plan.audience === activeAudience)
  const featuredPlan = audiencePlans.find((plan) => plan.id === activePlanId) ?? audiencePlans[0] ?? pricingPlans[0]
  const activeMeta = pricingAudienceMeta[activeAudience]

  const handleAudienceChange = useCallback((audience: PricingPlan['audience']) => {
    onAudienceChange(audience)
    setActivePlanId(getDefaultPricingPlanId(audience))

    if (typeof window !== 'undefined') {
      window.history.replaceState(null, '', audience === 'teams' ? '#plans-teams' : '#plans')
    }
  }, [onAudienceChange])

  useEffect(() => {
    const syncAudienceToHash = () => {
      if (window.location.hash === '#plans-teams') {
        onAudienceChange('teams')
        setActivePlanId(getDefaultPricingPlanId('teams'))
      }

      if (window.location.hash === '#plans' || window.location.hash === '#plans-individuals') {
        onAudienceChange('individuals')
        setActivePlanId(getDefaultPricingPlanId('individuals'))
      }
    }

    syncAudienceToHash()
    window.addEventListener('hashchange', syncAudienceToHash)

    return () => window.removeEventListener('hashchange', syncAudienceToHash)
  }, [onAudienceChange])

  useEffect(() => {
    if (!expandedPlan) return

    const previousOverflow = document.body.style.overflow
    const handleEscape = (event: KeyboardEvent) => {
      if (event.key === 'Escape') setExpandedPlan(null)
    }

    document.body.style.overflow = 'hidden'
    window.addEventListener('keydown', handleEscape)

    return () => {
      document.body.style.overflow = previousOverflow
      window.removeEventListener('keydown', handleEscape)
    }
  }, [expandedPlan])

  const renderSignalBars = (plan: PricingPlan) => (
    <div className="pricing-lab__signals" aria-label={`${plan.name} fit signals`}>
      {(planSignals[plan.id] ?? []).map((signal) => (
        <span key={signal.label}>
          <small>{signal.label}</small>
          <i>
            <b style={{ width: `${signal.value}%` }} />
          </i>
        </span>
      ))}
    </div>
  )

  const renderPlanCard = (plan: PricingPlan, index: number) => (
    <motion.button
      type="button"
      className={cn('pricing-lab-card', activePlanId === plan.id && 'is-active')}
      key={plan.id}
      onClick={() => setExpandedPlan(plan)}
      onFocus={() => setActivePlanId(plan.id)}
      onMouseEnter={() => setActivePlanId(plan.id)}
      style={{ '--plan-accent': plan.accent, '--plan-image-position': plan.imagePosition } as CSSProperties}
      initial={{ opacity: 0, y: 18, rotate: index % 2 === 0 ? -0.6 : 0.6 }}
      animate={{ opacity: 1, y: 0, rotate: index % 2 === 0 ? -0.25 : 0.25 }}
      transition={{ duration: 0.45, delay: index * 0.045, ease: 'easeOut' }}
      whileHover={{ y: -6, rotate: 0, transition: { duration: 0.22, ease: 'easeOut' } }}
    >
      <span className="pricing-lab-card__number">{String(index + 1).padStart(2, '0')}</span>
      <span className="pricing-lab-card__eyebrow">{plan.eyebrow}</span>
      <strong>{plan.name}</strong>
      <em>{plan.price}</em>
      <span className="pricing-lab-card__summary">{plan.summary}</span>
      <span className="pricing-lab-card__chips">
        {plan.details.slice(0, 3).map((detail) => (
          <span key={detail}>{detail}</span>
        ))}
      </span>
      <span className="pricing-lab-card__cta">
        Inspect fit
        <ArrowIcon />
      </span>
    </motion.button>
  )

  return (
    <section
      className="pricing-lab"
      data-audience={activeAudience}
      id="plans"
      aria-labelledby="pricing-title"
      style={
        {
          '--pricing-accent': activeMeta.accent,
          '--pricing-soft': activeMeta.soft,
          '--pricing-bg': activeMeta.background,
          '--pricing-on-bg': activeMeta.onBackground,
        } as CSSProperties
      }
    >
      <span id="plans-individuals" className="pricing-lab__anchor" aria-hidden="true" />
      <span id="plans-teams" className="pricing-lab__anchor" aria-hidden="true" />

      <div className="pricing-lab__shell">
        <div className="pricing-lab__intro">
          <motion.div className="pricing-lab__headline" {...getRevealMotionProps(reducedMotion, { x: -26, y: 18, duration: 0.86 })}>
            <motion.div
              className="section-kicker"
              {...getRevealMotionProps(reducedMotion, { y: 12, duration: 0.6, delay: 0.04 })}
            >
              Plans and pricing
            </motion.div>
            <h2 id="pricing-title">Because We’ve Got A Space 
              for Every Way You Work.</h2>
            <p>
              Whether you're a freelancer who needs a desk or an enterprise that
              needs a floor, we have a plan built around you, not the other way around.
            </p>
          </div>

          <div className="pricing-lab__switcher" role="tablist" aria-label="Pricing audience">
            {(['individuals', 'teams'] as const).map((audience) => (
              <button
                key={audience}
                type="button"
                role="tab"
                aria-selected={activeAudience === audience}
                className={cn(activeAudience === audience && 'is-active')}
                onClick={() => handleAudienceChange(audience)}
              >
                <span>{pricingAudienceMeta[audience].eyebrow}</span>
                <strong>{pricingAudienceMeta[audience].title}</strong>
              </button>
            ))}
          </div>
        </div>

        <div className="pricing-lab__stage">
          <AnimatePresence mode="wait">
            <motion.aside
              key={featuredPlan.id}
              className="pricing-lab__feature"
              style={{ '--plan-accent': featuredPlan.accent } as CSSProperties}
              initial={{ opacity: 0, y: 18, rotate: -0.6 }}
              animate={{ opacity: 1, y: 0, rotate: -0.25 }}
              exit={{ opacity: 0, y: -12, rotate: 0.4 }}
              transition={{ duration: 0.38, ease: 'easeOut' }}
            >
              <div className="pricing-lab__feature-glow" aria-hidden="true" />
              <div className="pricing-lab__feature-meta">
                <span>{activeMeta.title} path</span>
                <small>{featuredPlan.price}</small>
              </div>

              <div className="pricing-lab__feature-copy">
                <span>{featuredPlan.eyebrow}</span>
                <h3>{featuredPlan.name}</h3>
                <p>{featuredPlan.fit}</p>
              </div>

              {renderSignalBars(featuredPlan)}

              <div className="pricing-lab__feature-actions">
                <button type="button" className="primary-cta" onClick={() => setExpandedPlan(featuredPlan)}>
                  View plan
                  <ArrowIcon />
                </button>
                <a href="#book-tour">
                  Book a tour
                  <ArrowIcon />
                </a>
              </div>
            </motion.aside>
          </AnimatePresence>

          <div className="pricing-lab__board">
            <div className="pricing-lab__board-note">
              <span>{activeMeta.eyebrow}</span>
              <p>{activeMeta.lead}</p>
              <strong>{activeMeta.note}</strong>
            </div>

            <AnimatePresence mode="wait">
              <motion.div
                key={activeAudience}
                className="pricing-lab__cards"
                initial={{ opacity: 0, y: 16 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -12 }}
                transition={{ duration: 0.35, ease: 'easeOut' }}
              >
                <svg className="pricing-lab__sketch" viewBox="0 0 900 180" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M-20 112 C108 40 204 154 330 96 C472 30 594 128 734 74 C806 46 858 54 930 86" />
                </svg>
                {audiencePlans.map((plan, index) => renderPlanCard(plan, index))}
              </motion.div>
            </AnimatePresence>
          </div>
        </div>

        <div className="pricing-lab__footer">
          <span>Pricing here is a starting guide. Branch-specific availability and final fit are confirmed after a tour.</span>
          <a href="#book-tour">
            Let Work Hall recommend a setup
            <ArrowIcon />
          </a>
        </div>
      </div>

      {expandedPlan && (
        <div className="pricing-modal" role="dialog" aria-modal="true" aria-labelledby="pricing-modal-title">
          <button
            type="button"
            className="pricing-modal__backdrop"
            aria-label="Close pricing details"
            onClick={() => setExpandedPlan(null)}
          />
          <article
            className="pricing-modal__card"
            style={{ '--plan-accent': expandedPlan.accent } as CSSProperties}
          >
            <button
              type="button"
              className="pricing-modal__close"
              aria-label="Close pricing details"
              onClick={() => setExpandedPlan(null)}
            >
              ×
            </button>
            <span className="pricing-card__eyebrow">{expandedPlan.eyebrow}</span>
            <h3 id="pricing-modal-title">{expandedPlan.name}</h3>
            <strong>{expandedPlan.price}</strong>
            <p>{expandedPlan.summary}</p>
            <p>{expandedPlan.fit}</p>
            <div className="pricing-modal__details">
              {expandedPlan.details.map((detail) => (
                <span key={detail}>
                  <CheckIcon />
                  {detail}
                </span>
              ))}
            </div>
            <a href="#book-tour" className="primary-cta" onClick={() => setExpandedPlan(null)}>
              Start with this plan
              <ArrowIcon />
            </a>
          </article>
        </div>
      )}
    </section>
  )
}

function HeroVisual() {
  const visualRef = useRef<HTMLDivElement>(null)

  const handleVisualMove = (event: ReactMouseEvent<HTMLDivElement>) => {
    const node = visualRef.current
    if (!node) return

    const rect = node.getBoundingClientRect()
    const x = ((event.clientX - rect.left) / rect.width - 0.5) * 12
    const y = ((event.clientY - rect.top) / rect.height - 0.5) * 12

    node.style.setProperty('--tilt-x', `${y * -1}deg`)
    node.style.setProperty('--tilt-y', `${x}deg`)
    node.style.setProperty('--spot-x', `${event.clientX - rect.left}px`)
    node.style.setProperty('--spot-y', `${event.clientY - rect.top}px`)
  }

  const resetVisualMove = () => {
    const node = visualRef.current
    if (!node) return

    node.style.setProperty('--tilt-x', '0deg')
    node.style.setProperty('--tilt-y', '0deg')
  }

  return (
    <div
      ref={visualRef}
      className="hero-visual"
      onMouseMove={handleVisualMove}
      onMouseLeave={resetVisualMove}
      aria-label="Work Hall coworking lounge preview"
    >
      <img
        src="/cowork.jpg"
        alt="Work Hall coworking space interior"
      />
    </div>
  )
}

function LocationsMapSection() {
  const sectionRef = useRef<HTMLElement>(null)
  const mapNodeRef = useRef<HTMLDivElement>(null)
  const mapRef = useRef<maplibregl.Map | null>(null)
  const markersRef = useRef<maplibregl.Marker[]>([])
  const userMarkerRef = useRef<maplibregl.Marker | null>(null)
  const hasAutoRequestedLocationRef = useRef(false)
  const hasManualBranchSelectionRef = useRef(false)
  const [isMapReady, setIsMapReady] = useState(false)
  const [activeLocationId, setActiveLocationId] = useState(workHallLocations[0].id)
  const [isBranchMenuOpen, setIsBranchMenuOpen] = useState(false)
  const [userCoordinates, setUserCoordinates] = useState<UserCoordinates | null>(null)
  const [geoStatus, setGeoStatus] = useState<GeolocationStatus>('idle')
  const [geoMessage, setGeoMessage] = useState(
    'When this section enters view, your browser will ask for location access so we can start a route guide automatically.',
  )

  const activeLocation = workHallLocations.find((location) => location.id === activeLocationId) ?? workHallLocations[0]
  const rankedLocations = workHallLocations
    .map((location) => ({
      location,
      distance: userCoordinates ? getDistanceKm(userCoordinates, location) : null,
    }))
    .sort((first, second) => {
      if (first.distance === null || second.distance === null) return 0
      return first.distance - second.distance
    })
  const nearestLocation = userCoordinates ? rankedLocations[0] : null

  const requestLocationAccess = useCallback(
    ({
      preferNearest,
      trigger,
    }: {
      preferNearest: boolean
      trigger: 'auto' | 'manual'
    }) => {
      if (geoStatus === 'loading') return

      if (!('geolocation' in navigator)) {
        setGeoStatus('unsupported')
        setGeoMessage('This browser does not support location detection. You can still pick a branch manually.')
        return
      }

      setGeoStatus('loading')
      setGeoMessage(
        trigger === 'auto'
          ? 'Your browser is asking for location access. If allowed, the route guide starts automatically.'
          : 'Asking your browser for permission and preparing the route guide...',
      )

      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          const nextCoordinates = {
            longitude: coords.longitude,
            latitude: coords.latitude,
          }
          const nearest = workHallLocations.reduce((closest, location) =>
            getDistanceKm(nextCoordinates, location) < getDistanceKm(nextCoordinates, closest) ? location : closest,
          )
          const selectedLocation =
            workHallLocations.find((location) => location.id === activeLocationId) ?? nearest
          const shouldSwitchToNearest = preferNearest && !hasManualBranchSelectionRef.current
          const routedLocation = shouldSwitchToNearest ? nearest : selectedLocation

          setUserCoordinates(nextCoordinates)
          if (shouldSwitchToNearest) setActiveLocationId(nearest.id)
          setGeoStatus('located')
          setGeoMessage(`${routedLocation.area} now has an active route guide from your location.`)
        },
        (error) => {
          setGeoStatus('blocked')
          setGeoMessage(
            error.code === error.PERMISSION_DENIED
              ? 'Location permission was blocked, so the route guide will not start automatically.'
              : 'We could not detect your location right now. The branch list is still available below.',
          )
        },
        {
          enableHighAccuracy: true,
          maximumAge: 300000,
          timeout: 12000,
        },
      )
    },
    [activeLocationId, geoStatus],
  )

  useEffect(() => {
    const node = mapNodeRef.current
    if (!node || mapRef.current) return

    const map = new maplibregl.Map({
      container: node,
      style: 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json',
      center: karachiCenter,
      zoom: 10.7,
      pitch: 18,
      bearing: -6,
      attributionControl: false,
    })

    map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-left')
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right')

    const handleLoad = () => {
      setIsMapReady(true)
      map.resize()
    }

    map.on('load', handleLoad)
    mapRef.current = map

    return () => {
      map.off('load', handleLoad)
      markersRef.current.forEach((marker) => marker.remove())
      markersRef.current = []
      userMarkerRef.current?.remove()
      userMarkerRef.current = null
      map.remove()
      mapRef.current = null
      setIsMapReady(false)
    }
  }, [])

  useEffect(() => {
    const sectionNode = sectionRef.current
    if (!sectionNode || geoStatus !== 'idle' || hasAutoRequestedLocationRef.current) return

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting || hasAutoRequestedLocationRef.current) return

        hasAutoRequestedLocationRef.current = true
        requestLocationAccess({
          preferNearest: true,
          trigger: 'auto',
        })
        observer.disconnect()
      },
      {
        threshold: 0.34,
        rootMargin: '0px 0px -18% 0px',
      },
    )

    observer.observe(sectionNode)
    return () => observer.disconnect()
  }, [geoStatus, requestLocationAccess])

  useEffect(() => {
    const map = mapRef.current
    if (!map || !isMapReady) return

    markersRef.current.forEach((marker) => marker.remove())
    markersRef.current = workHallLocations.map((location) => {
      const markerAnchor = document.createElement('div')
      const pinButton = document.createElement('button')

      markerAnchor.className = 'location-marker-anchor'
      pinButton.type = 'button'
      pinButton.className = [
        'location-map-pin',
        location.status === 'mock' ? 'is-mock' : 'is-live',
        location.id === activeLocationId ? 'is-active' : '',
      ]
        .filter(Boolean)
        .join(' ')
      pinButton.setAttribute('aria-label', `View ${location.name}`)
      pinButton.addEventListener('click', () => {
        hasManualBranchSelectionRef.current = true
        setActiveLocationId(location.id)
      })
      markerAnchor.append(pinButton)

      return new maplibregl.Marker({
        element: markerAnchor,
        anchor: 'bottom',
        offset: [0, 0],
      })
        .setLngLat(location.coordinates)
        .addTo(map)
    })

    return () => {
      markersRef.current.forEach((marker) => marker.remove())
      markersRef.current = []
    }
  }, [activeLocationId, isMapReady])

  useEffect(() => {
    const map = mapRef.current
    if (!map || !isMapReady) return

    userMarkerRef.current?.remove()
    userMarkerRef.current = null

    if (!userCoordinates) return

    const markerElement = document.createElement('span')
    markerElement.className = 'user-location-pin'
    markerElement.setAttribute('aria-label', 'Your location')
    userMarkerRef.current = new maplibregl.Marker({
      element: markerElement,
      anchor: 'center',
    })
      .setLngLat([userCoordinates.longitude, userCoordinates.latitude])
      .addTo(map)

    return () => {
      userMarkerRef.current?.remove()
      userMarkerRef.current = null
    }
  }, [isMapReady, userCoordinates])

  useEffect(() => {
    const map = mapRef.current
    if (!map || !isMapReady) return

    if (!userCoordinates) {
      const source = map.getSource(routeSourceId) as maplibregl.GeoJSONSource | undefined
      source?.setData({
        type: 'FeatureCollection',
        features: [],
      })
      return
    }

    const routeData = createRouteData(userCoordinates, activeLocation)
    const existingSource = map.getSource(routeSourceId) as maplibregl.GeoJSONSource | undefined

    if (existingSource) {
      existingSource.setData(routeData)
      return
    }

    map.addSource(routeSourceId, {
      type: 'geojson',
      data: routeData,
      lineMetrics: true,
    })

    map.addLayer({
      id: routeCasingLayerId,
      type: 'line',
      source: routeSourceId,
      layout: {
        'line-cap': 'round',
        'line-join': 'round',
      },
      paint: {
        'line-color': 'rgba(255, 250, 240, 0.94)',
        'line-width': 10,
        'line-opacity': 0.95,
      },
    })

    map.addLayer({
      id: routeLayerId,
      type: 'line',
      source: routeSourceId,
      layout: {
        'line-cap': 'round',
        'line-join': 'round',
      },
      paint: {
        'line-color': '#321d32',
        'line-width': 5,
        'line-opacity': 0.92,
        'line-dasharray': [1, 1.25],
      },
    })
  }, [activeLocation, isMapReady, userCoordinates])

  useEffect(() => {
    const map = mapRef.current
    if (!map || !isMapReady) return

    if (userCoordinates) {
      const bounds = new maplibregl.LngLatBounds(
        [userCoordinates.longitude, userCoordinates.latitude],
        [userCoordinates.longitude, userCoordinates.latitude],
      )

      bounds.extend(activeLocation.coordinates)
      map.fitBounds(bounds, {
        padding: { top: 92, right: 96, bottom: 92, left: 96 },
        maxZoom: 13.8,
        duration: 1100,
        essential: true,
      })
      return
    }

    map.flyTo({
      center: activeLocation.coordinates,
      zoom: activeLocation.status === 'mock' ? 11.7 : 12.6,
      duration: 900,
      essential: true,
    })
  }, [activeLocation, isMapReady, userCoordinates])

  const showAllBranches = () => {
    const map = mapRef.current
    if (!map) return

    const bounds = new maplibregl.LngLatBounds(workHallLocations[0].coordinates, workHallLocations[0].coordinates)
    workHallLocations.slice(1).forEach((location) => bounds.extend(location.coordinates))
    if (userCoordinates) bounds.extend([userCoordinates.longitude, userCoordinates.latitude])

    map.fitBounds(bounds, {
      padding: { top: 80, right: 80, bottom: 80, left: 80 },
      maxZoom: 11.4,
      duration: 950,
      essential: true,
    })
  }

  return (
    <section
      ref={sectionRef}
      className="location-band location-band--live"
      id="locations"
      aria-labelledby="locations-title"
    >
      <div className="location-copy">
        <div className="section-kicker">Karachi network</div>
        <h2 id="locations-title">Find the Work Hall closest to you.</h2>
        <p>
          Share your location to instantly rank our Karachi branches by distance, then open
          the exact branch in Google Maps when you are ready to visit.
        </p>

        <div className="location-actions">
          <button
            type="button"
            className="primary-cta"
            onClick={() => requestLocationAccess({ preferNearest: true, trigger: 'manual' })}
            disabled={geoStatus === 'loading'}
          >
            {geoStatus === 'loading' ? 'Starting route...' : geoStatus === 'located' ? 'Refresh route' : 'Allow location'}
            <LocateIcon />
          </button>
          <button type="button" className="secondary-cta" onClick={showAllBranches}>
            View all branches
          </button>
        </div>

        <div className={`location-status location-status--${geoStatus}`} role="status">
          <strong>
            {geoStatus === 'located' && nearestLocation
              ? `Closest: ${nearestLocation.location.area}`
              : 'Location-aware branch finder'}
          </strong>
          <span>{geoMessage}</span>
        </div>
      </div>

      <div className="location-map-shell">
        <div className="location-map-header">
          <span>
            <small>Selected branch</small>
            <strong>{activeLocation.area}</strong>
          </span>
          <em className={activeLocation.status === 'mock' ? 'is-mock' : 'is-live'}>
            {activeLocation.status === 'mock' ? 'Mock pin' : 'Live source'}
          </em>
        </div>

        <div ref={mapNodeRef} className="workhall-map" aria-label="Interactive Work Hall locations map" />

        <div className="branch-drawer" aria-label="Work Hall branch selector">
          <div className="branch-drawer__lead">
            <span>Current pick</span>
            <strong>{activeLocation.area}</strong>
            <small>{activeLocation.address}</small>
          </div>

          <div className="branch-menu">
            <button
              type="button"
              className="branch-menu__field"
              aria-expanded={isBranchMenuOpen}
              onClick={() => setIsBranchMenuOpen((isOpen) => !isOpen)}
            >
              <span>
                <strong>Choose a Location</strong>
                <small>{activeLocation.area}</small>
              </span>
              <SearchIcon />
            </button>

            {isBranchMenuOpen && (
              <div className="branch-menu__panel">
                {rankedLocations.map(({ location, distance }) => (
                  <button
                    type="button"
                    key={location.id}
                    className={location.id === activeLocationId ? 'branch-option is-selected' : 'branch-option'}
                    onClick={() => {
                      hasManualBranchSelectionRef.current = true
                      setActiveLocationId(location.id)
                      setIsBranchMenuOpen(false)
                    }}
                  >
                    <span>
                      <strong>{location.area}</strong>
                      <small>{location.status === 'mock' ? 'Mock pin' : 'Live branch'}</small>
                    </span>
                    <em>{formatDistance(distance)}</em>
                  </button>
                ))}
              </div>
            )}
          </div>

          <a className="map-directions-link" href={activeLocation.mapsUrl} target="_blank" rel="noreferrer">
            Open in Google Maps
            <ArrowIcon />
          </a>
        </div>
      </div>
    </section>
  )
}

function App() {
  const [heroVariant, setHeroVariant] = useState<HeroVariant>(getInitialHeroVariant)
  const [pricingAudience, setPricingAudience] = useState<PricingPlan['audience']>(getInitialPricingAudience)
  const [showHeroReviewSwitch] = useState(shouldShowHeroReviewSwitch)
  useLenisSmoothScroll()
  const pricingTheme = pricingAudienceMeta[pricingAudience]

  const updateHeroVariant = (nextVariant: HeroVariant) => {
    setHeroVariant(nextVariant)
    window.localStorage.setItem('workhall-hero-variant', nextVariant)

    const url = new URL(window.location.href)
    url.searchParams.set('hero', nextVariant)
    if (showHeroReviewSwitch) {
      url.searchParams.set('heroReview', '1')
    }
    window.history.replaceState(null, '', url)
  }

  return (
    <ClickSpark sparkColor="#7a5132" sparkSize={7} sparkRadius={10} sparkCount={9} duration={460}>
      <main id="home" className="site-shell">
        <Waves
          className="site-waves"
          lineColor="rgba(95, 58, 37, 0.38)"
          backgroundColor="rgba(246, 232, 204, 0.55)"
          waveSpeedX={0.02}
          waveSpeedY={0.01}
          waveAmpX={46}
          waveAmpY={24}
          friction={0.9}
          tension={0.01}
          maxCursorMove={120}
          xGap={11}
          yGap={34}
          style={{ position: 'fixed', inset: 0, zIndex: 0 }}
        />

        <div className="site-nav-wrap">
          <WorkHallNav />
          {showHeroReviewSwitch && <HeroReviewSwitch variant={heroVariant} onChange={updateHeroVariant} />}
        </div>

        {heroVariant === 'editorial' ? <EditorialHero /> : <ClassicHero />}

        <section
          className="pricing-chapter"
          data-audience={pricingAudience}
          style={
            {
              '--pricing-accent': pricingTheme.accent,
              '--pricing-soft': pricingTheme.soft,
              '--pricing-bg': pricingTheme.background,
              '--pricing-on-bg': pricingTheme.onBackground,
            } as CSSProperties
          }
        >
          <PricingPlansCarousel activeAudience={pricingAudience} onAudienceChange={setPricingAudience} />

          <section
            className="service-section"
            id="workspace-services"
            aria-labelledby="services-title"
          >
            <div className="service-section__intro">
              <div>
                <div className="section-kicker">What you can book</div>
                <h2 id="services-title">and because work isn't always just a desk</h2>
                <p className="service-section__lead">
                  Pick the shape of the day first. Work Hall handles the room, rhythm,
                  access, and the little invisible things that make a workday feel lighter.
                </p>
              </div>
              <aside className="service-section__note" aria-label="Service guide">
                <span>Start with the room shape</span>
                <p>
                  Shared desks keep the day open, private suites hold focus in place,
                  and meeting rooms let the conversation arrive with more weight.
                </p>
              </aside>
            </div>
            <div className="service-grid">
              {services.map((service, index) => {
                const ServiceIcon = service.Icon

                return (
                  <article
                    key={service.title}
                    className={`service-card ${index === 0 ? 'service-card--featured' : 'service-card--support'}`}
                    style={
                      {
                        '--service-accent': service.accent,
                        '--service-image': 'url("/cowork.jpg")',
                        '--service-image-position': service.imagePosition,
                      } as CSSProperties
                    }
                  >
                    <span className="service-card__media" aria-hidden="true" />
                    <span className="service-card__top">
                      <span className="service-card__chip">
                        <span className="service-card__icon" aria-hidden="true">
                          <ServiceIcon />
                        </span>
                        <span className="service-card__eyebrow">{service.eyebrow}</span>
                      </span>
                      <span className="service-card__number">{String(index + 1).padStart(2, '0')}</span>
                    </span>
                    <div className="service-card__body">
                      <h3>{service.title}</h3>
                      <p>{service.body}</p>
                      <strong>{service.promise}</strong>
                    </div>
                    <div className="service-card__footer">
                      <div className="service-card__highlights" aria-label={`${service.title} highlights`}>
                        {service.highlights.map((item) => (
                          <span key={item}>{item}</span>
                        ))}
                      </div>
                      <a href="#book-tour">
                        {service.cta}
                        <ArrowIcon />
                      </a>
                    </div>
                  </article>
                )
              })}
            </div>
          </section>
        </section>

        <section
          className="story-band membership-band"
          id="why-work-hall"
          aria-labelledby="story-title"
        >
          <div className="membership-copy">
            <div className="section-kicker">How membership works</div>
            <h2 id="story-title">
              A workday that leaves room for{' '}
              <RotatingText
                texts={membershipWords}
                mainClassName="membership-rotating-word"
                splitLevelClassName="membership-rotating-word__group"
                elementLevelClassName="membership-rotating-word__letter"
                staggerFrom="last"
                staggerDuration={0.022}
                rotationInterval={2300}
                transition={{ type: 'spring', damping: 30, stiffness: 420 }}
              />
            </h2>
            <p>
              No cold front-desk energy. Tell us how your team moves through the day,
              walk the space, and let the room handle the small frictions before they
              turn into noise.
            </p>
            <div className="membership-note">
              <span>What your membership includes</span>
              <strong>walk in, choose your spot, take meetings, and work without managing an office.</strong>
            </div>
          </div>

          <div className="membership-system" aria-label="Work Hall membership steps">
            <div className="membership-orbit" aria-hidden="true">
              <span />
              <span />
              <span />
            </div>
            <ol className="membership-steps">
              {membershipSteps.map((step, index) => (
                <li key={step.title} style={{ '--step-accent-delay': `${index * 140}ms` } as CSSProperties}>
                  <span className="membership-step__index">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <span className="membership-step__overline">
                      {['Find the fit', 'Fit the room', 'Settle in'][index]}
                    </span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                    <em>{step.signal}</em>
                  </div>
                </li>
              ))}
            </ol>
            <div className="membership-dayline">
              {membershipDayNotes.map((note) => (
                <span key={note}>{note}</span>
              ))}
            </div>
          </div>
        </section>

        <LocationsMapSection />

        <footer className="site-footer" id="contact">
          <WorkHallLogo />
          <div>
            <strong>Re-think the way your team works.</strong>
            <span>Flexible desks, private offices, and meeting rooms built around community.</span>
          </div>
          <a href="#book-tour" className="primary-cta">
            Book a Tour
            <ArrowIcon />
          </a>
        </footer>
      </main>
    </ClickSpark>
  )
}

export default App
