function useReducedMotion() {
  const [reducedMotion, setReducedMotion] = useState(false)

  useEffect(() => {
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const updatePreference = () => setReducedMotion(mediaQuery.matches)

    updatePreference()
    mediaQuery.addEventListener('change', updatePreference)

    return () => mediaQuery.removeEventListener('change', updatePreference)
  }, [])

  return reducedMotion
}

function AnimatedMetric({
  value,
  label,
  suffix = '',
  delay,
  color,
  formatter,
}: {
  value: number
  label: string
  suffix?: string
  delay: number
  color: string
  formatter?: (value: number) => string
}) {
  const ref = useRef<HTMLDivElement>(null)
  const [isVisible, setIsVisible] = useState(false)
  const [count, setCount] = useState(0)
  const reducedMotion = useReducedMotion()

  useEffect(() => {
    const node = ref.current
    if (!node) return

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsVisible(true)
          observer.disconnect()
        }
      },
      { threshold: 0.35 },
    )

    observer.observe(node)
    return () => observer.disconnect()
  }, [])

  useEffect(() => {
    if (!isVisible) return

    if (reducedMotion) {
      return
    }

    let animationFrame = 0
    let startTime = 0
    const duration = 1600
    const timer = window.setTimeout(() => {
      const tick = (time: number) => {
        if (!startTime) startTime = time
        const progress = Math.min((time - startTime) / duration, 1)
        const eased =
          progress < 0.5
            ? 4 * progress * progress * progress
            : 1 - Math.pow(-2 * progress + 2, 3) / 2

        setCount(Math.round(value * eased))

        if (progress < 1) {
          animationFrame = window.requestAnimationFrame(tick)
        }
      }

      animationFrame = window.requestAnimationFrame(tick)
    }, delay)

    return () => {
      window.clearTimeout(timer)
      window.cancelAnimationFrame(animationFrame)
    }
  }, [delay, isVisible, reducedMotion, value])

  const visibleCount = reducedMotion && isVisible ? value : count
  const displayValue = formatter ? formatter(visibleCount) : String(visibleCount)

  return (
    <div ref={ref} className="metric" style={{ '--metric-color': color } as CSSProperties}>
      <strong>
        {displayValue}
        {suffix}
      </strong>
      <span>{label}</span>
    </div>
  )
}

function MetricsStrip() {
  return (
    <div className="metrics-strip" aria-label="Work Hall impact numbers">
      <AnimatedMetric
        value={6}
        label="Locations"
        delay={100}
        color="#2f8d71"
        formatter={(value) => value.toString().padStart(2, '0')}
      />
      <AnimatedMetric
        value={7}
        label="Years"
        suffix="+"
        delay={240}
        color="#d46543"
        formatter={(value) => value.toString().padStart(2, '0')}
      />
      <AnimatedMetric value={800} label="Seats" suffix="+" delay={380} color="#315aa8" />
      <AnimatedMetric
        value={40000}
        label="Sq. ft. area"
        suffix="+"
        delay={520}
        color="#8c8867"
        formatter={(value) => `${Math.round(value / 1000)}k`}
      />
    </div>
  )
}

type HeroVariant = 'editorial' | 'classic'

function getInitialHeroVariant(): HeroVariant {
  if (typeof window === 'undefined') return 'editorial'

  const params = new URLSearchParams(window.location.search)
  const requestedVariant = params.get('hero')
  if (requestedVariant === 'classic' || requestedVariant === 'editorial') return requestedVariant

  const storedVariant = window.localStorage.getItem('workhall-hero-variant')
  if (storedVariant === 'classic' || storedVariant === 'editorial') return storedVariant

  return 'editorial'
}

function shouldShowHeroReviewSwitch() {
  if (typeof window === 'undefined') return false

  const params = new URLSearchParams(window.location.search)
  return import.meta.env.DEV || params.get('heroReview') === '1' || params.has('hero')
}

const lenisPreventSelector = [
  '[data-lenis-prevent]',
  'input',
  'textarea',
  'select',
  '[contenteditable="true"]',
  '.site-nav__dropdown',
  '.booking-popover__panel',
  '.branch-menu__panel',
  '.enquiry-modal',
  '.pricing-modal',
  '.workhall-map',
  '.maplibregl-map',
  '.maplibregl-canvas',
].join(', ')

function useLenisSmoothScroll() {
  useEffect(() => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const lenis = new Lenis({
      duration: prefersReducedMotion ? 0.15 : 1.05,
      easing: (time) => Math.min(1, 1.001 - Math.pow(2, -10 * time)),
      smoothWheel: true,
      syncTouch: true,
      syncTouchLerp: 0.08,
      anchors: true,
      prevent: (node) => Boolean(node.closest(lenisPreventSelector)),
    })

    let rafId = 0
    const raf = (time: number) => {
      lenis.raf(time)
      rafId = window.requestAnimationFrame(raf)
    }

    rafId = window.requestAnimationFrame(raf)

    return () => {
      window.cancelAnimationFrame(rafId)
      lenis.destroy()
    }
  }, [])
}

