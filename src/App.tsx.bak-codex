function toRadians(value: number) {
  return (value * Math.PI) / 180
}

function getDistanceKm(userCoordinates: UserCoordinates, location: WorkHallLocation) {
  const earthRadiusKm = 6371
  const latitudeDelta = toRadians(location.coordinates[1] - userCoordinates.latitude)
  const longitudeDelta = toRadians(location.coordinates[0] - userCoordinates.longitude)
  const userLatitude = toRadians(userCoordinates.latitude)
  const locationLatitude = toRadians(location.coordinates[1])
  const haversine =
    Math.sin(latitudeDelta / 2) ** 2 +
    Math.cos(userLatitude) * Math.cos(locationLatitude) * Math.sin(longitudeDelta / 2) ** 2

  return 2 * earthRadiusKm * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine))
}

function formatDistance(distance: number | null) {
  if (distance === null) return 'Enable location'
  if (distance < 1) return `${Math.round(distance * 1000)} m away`
  if (distance < 100) return `${distance.toFixed(1)} km away`
  return `${Math.round(distance).toLocaleString()} km away`
}

function buildGuideRoute(from: [number, number], to: [number, number]) {
  const [fromLongitude, fromLatitude] = from
  const [toLongitude, toLatitude] = to
  const longitudeDelta = toLongitude - fromLongitude
  const latitudeDelta = toLatitude - fromLatitude
  const midpoint: [number, number] = [
    fromLongitude + longitudeDelta * 0.52 - latitudeDelta * 0.08,
    fromLatitude + latitudeDelta * 0.52 + longitudeDelta * 0.08,
  ]
  const route: [number, number][] = []

  for (let index = 0; index <= 36; index += 1) {
    const progress = index / 36
    const inverse = 1 - progress
    route.push([
      inverse * inverse * fromLongitude + 2 * inverse * progress * midpoint[0] + progress * progress * toLongitude,
      inverse * inverse * fromLatitude + 2 * inverse * progress * midpoint[1] + progress * progress * toLatitude,
    ])
  }

  return route
}

function createRouteData(userCoordinates: UserCoordinates, location: WorkHallLocation) {
  return {
    type: 'FeatureCollection' as const,
    features: [
      {
        type: 'Feature' as const,
        properties: {},
        geometry: {
          type: 'LineString' as const,
          coordinates: buildGuideRoute(
            [userCoordinates.longitude, userCoordinates.latitude],
            location.coordinates,
          ),
        },
      },
    ],
  }
}

